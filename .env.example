# Copier en .env puis remplir. Ne jamais versionner .env.
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASSWORD=change-me-admin
GENERATOR_PASSWORD=change-me-gen
DASHBOARD_PASSWORD=change-me-dash

# Adresses des deux PC (adresses Tailscale recommandées, elles ne changent pas)
PC_A_IP=100.0.0.1
PC_B_IP=100.0.0.2

MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0
DB_NAME=fleet
TRUCK_COUNT=100
INTERVAL_SECONDS=5
BATCH_SIZE=500