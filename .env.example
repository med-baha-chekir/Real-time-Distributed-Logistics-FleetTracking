# Copier en .env puis adapter. Ne jamais versionner .env.
#
# Décision réseau (sprint 2) : tout le cluster tourne sur le PC de A.
# Les ports MongoDB ne sont exposés que sur 127.0.0.1 ; le générateur et le
# dashboard tournent dans des conteneurs du réseau Docker "fleet-net".

# --- Connexion MongoDB -------------------------------------------------------
# Depuis un conteneur du réseau fleet-net (cas normal) :
MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0
# Depuis la machine hôte, sans Docker (un seul nœud, pas de failover) :
# MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
DB_NAME=fleet

# --- Générateur v1 -----------------------------------------------------------
TRUCK_COUNT=100
INTERVAL_SECONDS=5
BATCH_SIZE=500
# Durée totale en secondes ; 0 = exécution continue
DURATION_SECONDS=0

# --- Générateur v2 (lus par le code à partir du sprint 2) --------------------
# Write concern des insertions : "majority" ou "1" (comparaison pour le rapport)
WRITE_CONCERN=majority
# Graine aléatoire pour des jeux de données reproductibles
SEED=42
# "realtime" (démo, failover) ou "backfill" (chargement rapide de millions de docs)
MODE=realtime
